{% extends "layouts/expert_base.html.jinja" %}
{% block main %}
<nav aria-label="Terug navigatie">
    <a href="/expert/enrollments">Terug naar overzicht onderzoek</a>
</nav>

<section aria-labelledby="onderzoek-titel">
    <h2 id="onderzoek-titel">Details Organisatie</h2>

    <pre>{{ enrollment }}</pre>
    <dl>
        <dt><strong>Organisatie</strong></dt>
        <dd>{{ enrollment.organization_name}}</dd>

        <dt><strong>Info</strong></dt>
        <dd>{{ enrollment.organization_description}}</dd>

        <dt><strong>Website</strong></dt>
        <dd>{{ enrollment.organization_website}}</dd>
    </dl>

    <h2>Details opdracht</h2>
    <dl>
        <dt><strong>Status</strong></dt>
        <dd>{{ enrollment.enrollment_status}}</dd>

        <dt><strong>Titel</strong></dt>
        <dd>{{ enrollment.study_title }}</dd>

        <dt><strong>Beschrijving</strong></dt>
        <dd>{{ enrollment.study_description}}</dd>

        <dt><strong>Type onderzoek</strong></dt>
        <dd>{{ enrollment.study_type}}</dd>

        <dt><strong>Locatie</strong></dt>
        <dd>{{ enrollment.study_location}}</dd>

        <dt><strong>Vergoeding</strong></dt>
        <dd>{{ enrollment.study_reward}}</dd>

        <dt><strong>Beschikbaarheid</strong></dt>
        <dd>{{ enrollment.study_available}}</dd>

        <dt><strong>Start</strong></dt>
        <dd>{{ enrollment.study_start_date}}</dd>

        <dt><strong>Stopt</strong></dt>
        <dd>{{ enrollment.study_end_date}}</dd>
    </dl>

</section>

{% endblock %}