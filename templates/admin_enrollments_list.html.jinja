{% extends 'layouts/admin_base.html.jinja' %}

{% block title %}Inschrijvingen{% endblock %}

{% block content %}
<h2>Inschrijvingen</h2>

<section aria-labelledby="enrollments-heading">
    <div class="section-header">
        <h3 id="enrollments-heading">Alle Inschrijvingen</h3>
        <a href="{{ url_for('export_enrollments_csv') }}" class="btn btn-primary">Exporteer inschrijvingen (CSV)</a>
    </div>

    <form method="GET" action="{{ url_for('admin_enrollments') }}" class="filters">
        <label for="filter-status-enrollments">Filter op status:</label>
        <select id="filter-status-enrollments" name="status">
            <option value="" {% if not status %}selected{% endif %}>Alle</option>
            <option value="nieuw" {% if status=='nieuw' %}selected{% endif %}>Nieuw</option>
            <option value="goedgekeurd" {% if status=='goedgekeurd' %}selected{% endif %}>Goedgekeurd</option>
            <option value="afgekeurd" {% if status=='afgekeurd' %}selected{% endif %}>Afgekeurd</option>
        </select>

        <button type="submit" class="btn btn-primary">Filteren</button>
    </form>

    <div class="table-wrapper">
        <table>
            <caption class="visually-hidden">Lijst van alle inschrijvingen op onderzoeken</caption>
            <thead>
                <tr>
                    <th scope="col">Ervaringsdeskundige</th>
                    <th scope="col">Onderzoek</th>
                    <th scope="col">Inschrijfdatum</th>
                    <th scope="col">Status</th>
                    <th scope="col">Acties</th>
                </tr>
            </thead>
            <tbody>
                {% for en in enroll %}
                <tr>
                    <td>{{ en["first_name"]}} {{ en["last_name"]}}</td>
                    <td>{{ en["study_title"]}}</td>
                    <td>{{ en["enrollment_created_at"] }}</td>
                    <td><span class="status-badge status-{{ en['enrollment_status'] }}">{{
                            en["enrollment_status"] }}</span></td>
                    <td>
                        <div class="action-buttons">
                            <a href="{{ url_for('admin_enrollment_detail', enroll_id=en['enrollment_id'])}}"
                                class="btn btn-secondary">Bekijk</a>
                            {% if en["enrollment_status"] == "nieuw" %}
                            <form method="post"
                                action="{{ url_for('approve_enrollment', enroll_id=en['enrollment_id']) }}"
                                style="display: inline;">
                                <button type="submit" class="btn btn-success">Goedkeuren</button>
                            </form>
                            <form method="post"
                                action="{{ url_for('reject_enrollment', enroll_id=en['enrollment_id']) }}"
                                style="display: inline;">
                                <button type="submit" class="btn btn-danger">Afkeuren</button>
                            </form>
                            {% endif %}
                        </div>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <div class="pagination" role="navigation" aria-label="Pagina navigatie">
        {% if page > 1 %}
        <a href="{{ url_for('admin_enrollments', page=page-1, status=status) }}" aria-label="Vorige pagina">‹
            Vorige</a>
        {% endif %}

        {% for p in range(1, total_pages + 1) %}
        {% if p == page %}
        <span aria-current="page" class="current">{{ p }}</span>
        {% elif p == 1 or p == total_pages or (p >= page - 2 and p <= page + 2) %} <a
            href="{{ url_for('admin_enrollments', page=p, status=status) }}">{{ p }}</a>
            {% elif p == page - 3 or p == page + 3 %}
            <span>...</span>
            {% endif %}
            {% endfor %}

            {% if page < total_pages %} <a href="{{ url_for('admin_enrollments', page=page+1, status=status) }}"
                aria-label="Volgende pagina">Volgende ›</a>
                {% endif %}
    </div>
</section>
{% endblock %}